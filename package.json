{
  "name": "@dreww/design",
  "version": "1.10.0",
  "private": true,
  "description": "Dreww design system: app tokens, Tailwind 4 theme, component CSS and React components; web tokens, components, motion and Tailwind 3 preset for dreww.ca.",
