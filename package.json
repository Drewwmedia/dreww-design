    "./react": "./src/react/index.ts",
    "./charts": "./src/charts/palette.ts",
    "./web/tokens.css": "./web/tokens.css",
    "./web/base.css": "./web/base.css",
    "./web/components.css": "./web/components.css",
    "./web/motion.js": "./web/motion.js",
    "./web/tailwind-preset": "./web/tailwind.preset.js",
    "./web/icons.svg": "./web/icons.svg",
    "./web/glossary.json": "./web/glossary.json",
    "./web/fr.js": "./web/fr.js"
  },
  "files": [
    "src",
    "web",
    "CLAUDE.md",
    "README.md"
